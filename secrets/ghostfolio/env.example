# Ghostfolio environment — TEMPLATE ONLY (placeholders).
#
# This file is committed in plaintext on purpose so the service can be pushed
# without decrypting real secrets. To go live:
#   1. Copy this, fill in real values (see the "generate with" hints below).
#   2. agenix -e secrets/ghostfolio/env.age   (paste the filled-in contents)
#   3. The secrets/secrets.nix entry is already present on this branch.
#
# Generate strong random values with:
#   openssl rand -hex 32

# --- Postgres (consumed by the ghostfolio-db container) ---
POSTGRES_DB=ghostfolio
POSTGRES_USER=ghostfolio
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# --- Redis (consumed by ghostfolio-redis and ghostfolio) ---
REDIS_HOST=ghostfolio-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- Ghostfolio app ---
# host = the postgres container name on ghostfolio-net; keep user/password/db in sync with the Postgres block above.
DATABASE_URL=postgresql://ghostfolio:CHANGE_ME_postgres_password@ghostfolio-db:5432/ghostfolio?connect_timeout=300&sslmode=prefer
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ACCESS_TOKEN_SALT=CHANGE_ME_openssl_rand_hex_32
NODE_ENV=production
PORT=3333
